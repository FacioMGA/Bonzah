[Unit]
Description=Verify Facio Platform off-host backup in a disposable PostgreSQL database
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /srv/facio-platform/deploy/backup.py --verify-restore
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/facio-platform/backups
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
