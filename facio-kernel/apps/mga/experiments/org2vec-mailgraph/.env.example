# --- LLM provider (one is required) ---
# Models are aligned with the assignment paper (Section 10): GPT-4o + 3-large.
# For cheaper local iteration, swap to gpt-4o-mini + text-embedding-3-small;
# the disk cache and prompts work identically, but cache keys are
# provider+model-scoped so switching models invalidates old responses.
#
# Azure OpenAI (primary)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large

# OpenAI (fallback) — used when AZURE_OPENAI_API_KEY is empty
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-large

# --- Connectors (optional; only needed if you click "Connect ...") ---
# Microsoft 365 (Azure App Registration; public client, device-code flow)
MS_CLIENT_ID=
MS_TENANT=common
MS_SCOPES=Mail.Read,offline_access

# Google (OAuth desktop client; InstalledAppFlow loopback)
GOOGLE_CLIENT_SECRETS_JSON=./.cache/google_client_secret.json
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# --- Determinism ---
ORG2VEC_SEED=20260528
ORG2VEC_TEMPERATURE=0.0
ORG2VEC_OFFLINE=0   # 1 = never call an LLM; use cached responses only
