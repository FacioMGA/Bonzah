# FacioMGA - Worker container (Chromium/Puppeteer)
#
# Purpose: run BullMQ workers (documents, notifications, etc.) with Chromium installed.
# Deploy this as a separate service (Azure Container Apps / separate App Service) and set:
# - QUEUE_WORKERS_ENABLED=true

FROM node:22-bookworm-slim AS backend-builder
WORKDIR /app
ENV PUPPETEER_SKIP_DOWNLOAD=1
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1
# tsc memory grows with the number of source files in the program; the
# operator MCP V2 additions pushed it past Node's default ~2 GB heap
# during `npm run build:api` and CI started failing with "Ineffective
# mark-compacts near heap limit". 4 GB gives headroom for future module
# growth without changing tsconfig or the npm script.
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN npm install -g npm@11.10.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY packages/ ./packages/
RUN npm ci
COPY tsconfig.json ./
COPY prisma/ ./prisma/
COPY backend/ ./backend/
COPY tools/quality/ ./tools/quality/
COPY tools/migrations/ ./tools/migrations/
COPY frontend/src/modules/policies/list/ ./frontend/src/modules/policies/list/
COPY email-templates-temp/ ./email-templates-temp/
COPY docs/architecture/baselines/ ./docs/architecture/baselines/
RUN npm run prisma:generate
RUN npm run build:api

FROM node:22-bookworm-slim AS production
WORKDIR /app
RUN npm install -g npm@11.10.0

# Install Chromium + runtime deps required by Puppeteer.
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    xdg-utils \
  && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_DOWNLOAD=1
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

COPY package*.json ./
COPY packages/ ./packages/
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=backend-builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=backend-builder /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=backend-builder /app/packages ./packages
COPY --from=backend-builder /app/tools/migrations ./tools/migrations
# The policy-list registry is canonical runtime configuration. The worker
# imports the policy read module at startup, so it must carry the same source
# file as the API image; TypeScript does not emit this JSON asset.
COPY --from=backend-builder /app/frontend/src/modules/policies/list ./frontend/src/modules/policies/list
RUN test -f ./frontend/src/modules/policies/list/registry.json
# `tools/quality/ops/prove-issued-docs-and-email.ts` is invoked by the
# `abbeygate-issuance-proof` CronJob (and the post-deploy proof job) via
# `node ./node_modules/tsx/dist/cli.mjs ...`. tsx is in dependencies
# (not devDependencies) so it survives `npm ci --omit=dev`; the script falls
# back from source imports to backend/dist imports in the runtime image.
COPY --from=backend-builder /app/tools/quality ./tools/quality
COPY --from=backend-builder /app/backend/dist ./backend/dist
COPY --from=backend-builder /app/backend/platform/behavior/manifest/policyBehaviorManifest.json ./backend/dist/platform/behavior/manifest/policyBehaviorManifest.json
RUN test -f ./backend/dist/platform/behavior/manifest/policyBehaviorManifest.json

COPY --from=backend-builder /app/email-templates-temp ./email-templates-temp

# Templates/assets required for PDF generation
COPY --from=backend-builder /app/backend/products/motor/documents/templates ./backend/dist/products/motor/documents/templates
RUN test -f ./backend/dist/products/motor/documents/templates/certificate.html && \
    test -f ./backend/dist/products/motor/documents/templates/schedule.html && \
    test -f ./backend/dist/products/motor/documents/templates/endorsements.html && \
    test -f ./backend/dist/products/motor/documents/templates/invoice.html && \
    test -f ./backend/dist/products/motor/documents/templates/green-card.html && \
    test -f ./backend/dist/products/motor/documents/templates/statement-of-fact.html

COPY --from=backend-builder /app/backend/products/motor/documents/static ./backend/dist/products/motor/documents/static
RUN test -f ./backend/dist/products/motor/documents/static/Abbeygate_Motor_Cyprus_Policy_Wording_AB-S-1-2026.pdf && \
    test -f ./backend/dist/products/motor/documents/static/Abbeygate_Motor_Cyprus_IPID_LIC_Santam_UMR_B176026EEA6152.pdf && \
    test -f ./backend/dist/products/motor/documents/static/Abbeygate_Motor_Portugal_IPID_LIC_Santam_August2026.pdf && \
    test -f ./backend/dist/products/motor/documents/static/Abbeygate_Motor_Portugal_Policy_Wording_AB-S-1-2026.pdf && \
    test -f ./backend/dist/products/motor/documents/static/Abbeygate_Motor_Spain_Policy_Wording_AB-S-1-2026.pdf

# ADR-0017 / ABY-97 — HOME + TRAVEL doc-pack templates. The previous
# worker image only carried motor templates, so the worker's
# `compile(templatesDir, 'certificate.html', data)` threw ENOENT for
# every home/travel issuance, BullMQ exhausted retries, and the
# customer wizard polled `pending` (now `failed`, per ADR-0017)
# forever. THIS WORKER IS WHERE THE BUG ACTUALLY MANIFESTS — the API
# pod only enqueues the job; the worker pod renders. Both Dockerfiles
# must stay in sync.
COPY --from=backend-builder /app/backend/products/home/documents/templates ./backend/dist/products/home/documents/templates
COPY --from=backend-builder /app/backend/products/travel/documents/templates ./backend/dist/products/travel/documents/templates
COPY --from=backend-builder /app/backend/products/health/documents/templates ./backend/dist/products/health/documents/templates
COPY --from=backend-builder /app/backend/products/rental/documents/templates ./backend/dist/products/rental/documents/templates
RUN test -f ./backend/dist/products/home/documents/templates/schedule.html && \
    test -f ./backend/dist/products/home/documents/templates/statement-of-fact.html && \
    test -f ./backend/dist/products/travel/documents/templates/certificate.html && \
    test -f ./backend/dist/products/travel/documents/templates/schedule.html && \
    test -f ./backend/dist/products/travel/documents/templates/ipid.html && \
    test -f ./backend/dist/products/travel/documents/templates/medical-card.html && \
    test -f ./backend/dist/products/travel/documents/templates/statement-of-fact.html && \
    test -f ./backend/dist/products/health/documents/templates/schedule.html && \
    test -f ./backend/dist/products/health/documents/templates/certificate.html && \
    test -f ./backend/dist/products/health/documents/templates/statement-of-fact.html

# Pricing data JSON (motor + home rate matrices). The TS compiler does not
# copy non-.ts assets, so these must be staged alongside the compiled JS
# that resolves them via `path.dirname(import.meta.url)`. Loaded eagerly at
# module top-level by `autoInsuranceCalculator.ts` and `homeRateCards.ts`,
# so a missing file crashes the worker at startup with `ENOENT`.
COPY --from=backend-builder /app/backend/products/motor/pricing/data ./backend/dist/products/motor/pricing/data
COPY --from=backend-builder /app/backend/products/home/pricing/data ./backend/dist/products/home/pricing/data
COPY --from=backend-builder /app/backend/products/travel/pricing/data ./backend/dist/products/travel/pricing/data
COPY --from=backend-builder /app/backend/products/health/pricing/data ./backend/dist/products/health/pricing/data
RUN test -f ./backend/dist/products/motor/pricing/data/abbeygate-auto-cyprus-2022.json && \
    test -f ./backend/dist/products/motor/pricing/data/classic-car-rates.json && \
    test -f ./backend/dist/products/home/pricing/data/home-rates-2026.json && \
    test -f ./backend/dist/products/home/pricing/data/wildfire-risk-tiers.json && \
    test -f ./backend/dist/products/travel/pricing/data/brit-travel-2025.json && \
    test -f ./backend/dist/products/travel/pricing/data/travel-eu-tax-rates.json && \
    test -f ./backend/dist/products/travel/pricing/data/travel-fee-bands.json && \
    test -f ./backend/dist/products/health/pricing/data/brit-health-2026.json

# ADR-0017 / ABY-97 — HOME doc-pack `staticPdf` entries (IPID, policy
# wording, Europ Assistance booklet) live under the product folder per
# CHAMPS canonical-ownership and the root-hygiene guard. Mirror them
# into dist/ alongside the compiled `documentPackContract.js` that
# resolves them via `path.join(path.dirname(import.meta.url), 'static', ...)`.
# Same story as templates above: this is the WORKER image, where
# `staticPdf` reads actually happen.
COPY --from=backend-builder /app/backend/products/home/documents/static ./backend/dist/products/home/documents/static
RUN test -f ./backend/dist/products/home/documents/static/BeazleyHome_IPID_CyprusGreeceWithSubsidence2023.pdf && \
    test -f ./backend/dist/products/home/documents/static/BeazleyHome_IPID_SpainAndPortugal.pdf && \
    test -f "./backend/dist/products/home/documents/static/Beazley_Lloyds_Home_Policy_Wording_Cyprus_(CyprusDomiciled).pdf" && \
    test -f "./backend/dist/products/home/documents/static/LloydsHomePolicyWordingCyprus(UKDomiciled)_2024.pdf" && \
    test -f ./backend/dist/products/home/documents/static/Beazley_Home_Portugal_Domiciled_Policy_Wording_Amended_Clean.pdf && \
    test -f ./backend/dist/products/home/documents/static/Beazley_Home_Portugal_UK_Domiciled_Policy_Wording_Amended_Clean.pdf && \
    test -f ./backend/dist/products/home/documents/static/Abbeygate_Home_Greece_Domiciled.pdf && \
    test -f ./backend/dist/products/home/documents/static/Abbeygate_Home_Greece_UK_Domiciled.pdf && \
    test -f ./backend/dist/products/home/documents/static/LloydsHome_IPID_GR.pdf && \
    test -f ./backend/dist/products/home/documents/static/NDP82515223207-04-2026.pdf

# Travel issued-pack policy wording is also a static PDF. Keep it under
# the product document contract so the image build fails before the worker
# can throw ENOENT during issuance.
COPY --from=backend-builder /app/backend/products/travel/documents/static ./backend/dist/products/travel/documents/static
RUN test -f ./backend/dist/products/travel/documents/static/Brit_Travel_Policy_Wording_Amended_Clean.pdf && \
    test -f ./backend/dist/products/travel/documents/static/Brit_Travel_SingleTrip_IPID.pdf && \
    test -f ./backend/dist/products/travel/documents/static/Brit_Travel_AnnualMultiTrip_IPID.pdf

# HEALTH (Brit Immigration Medical) issued-pack static PDFs — IPID and
# Section A policy wording. Worker does the actual `staticPdf` reads
# during issuance. Combined with the rate-card JSON copy above, this
# unblocks startup (`endorsementTemplates.ts` does module-load-time
# `loadHealthBaseCover()`) AND issuance (doc pack assembly).
COPY --from=backend-builder /app/backend/products/health/documents/static ./backend/dist/products/health/documents/static
RUN test -f ./backend/dist/products/health/documents/static/BritImmigrationHealthIPID.pdf && \
    test -f ./backend/dist/products/health/documents/static/Abbeygate_Immigration_Health_Wording.pdf

# ADR-0047 — tenant terms-of-business PDFs. This is the WORKER image, where
# the COMMUNICATION_OUTBOUND job actually calls `sendEmail` ->
# `appendTenantTermsAttachment` -> `fs.readFileSync(.../static/Terms...pdf)`.
# The Sentry ENOENT that blocked all CY+PT customer emails fired here.
# Ship the asset and assert it at build time (same spine as product statics).
COPY --from=backend-builder /app/backend/modules/communications/infra/adapters/static ./backend/dist/modules/communications/infra/adapters/static
RUN test -f ./backend/dist/modules/communications/infra/adapters/static/TermsAndConditions_CY.pdf && \
    test -f ./backend/dist/modules/communications/infra/adapters/static/TermsAndConditions_PT.pdf

RUN useradd -m -u 1001 nodejs
USER nodejs

# See Dockerfile.api comment on the single `--import` pattern.
CMD ["node", "--import", "./backend/dist/platform/observability/instrument.js", "backend/dist/worker.js"]
