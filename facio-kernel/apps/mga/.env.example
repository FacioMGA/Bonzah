# ──────────────────────────────────────────────
# Abbeygate Platform — Environment Variables
# Copy to .env and fill in values for local dev.
# ──────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000

# Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/abbeygate_dev?schema=public

# Org2Vec graph store (ADR-0041 / ADR-0044) — optional enrichment.
# Leave NEO4J_URI empty to disable the graph; the app degrades gracefully
# (memory objects still compute from Postgres, just without graph signals).
# For the local demo, `docker compose up neo4j` then uncomment below:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password123
# NEO4J_DATABASE=neo4j
# Live Microsoft Graph email pull (off by default; demo uses sample/upload).
# ORG2VEC_GRAPH_ENABLED=false

# Auth
# JWT_SECRET is required in every environment. Local-dev value below is a
# placeholder that the startup-validator REJECTS in production; use a strong
# random secret for any non-local environment (e.g. `openssl rand -hex 32`).
JWT_SECRET=local-only-change-me-with-openssl-rand-hex-32
OTP_SECRET=local-only-change-me-with-openssl-rand-hex-32

# Tenancy (ADR-0017 — fail-closed)
# Production HTTP traffic resolves the operating tenant via JWT claim,
# X-Tenant-Slug header, or tenant-aware host. There is NO env-singleton
# fallback in `getTenantConfig()`; outside an ALS context it throws.
#
# `TENANT_SLUG` and `DEFAULT_REGION_CODE` here exist solely for CLI / test
# entrypoints (seed.ts, scripts/*.mts, BDX migration scripts) which call
# `buildTenantConfigFromEnv()` to materialise an explicit TenantConfig.
# Production K8s manifests must NOT set these. Single-tenant deploys can
# set TENANT_SLUG to opt into resolveSlug() step 4 — slug-resolution only,
# not config construction.
# TENANT_SLUG=abbeygate-cy
# DEFAULT_REGION_CODE=CY

# SendGrid event-webhook ECDSA public key (PEM). Required in production for
# SendGrid event webhook verification. Fetch from SendGrid dashboard ->
# Mail Settings -> Event Webhook -> "Verification key".
# SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=

# Storage
STORAGE_PROVIDER=local
# STORAGE_CONNECTION_STRING=
# STORAGE_CONTAINER_NAME=faciomga-uploads

# Redis (BullMQ, caching)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false
# REDIS_ENABLE_CLUSTER=false

# Email (SendGrid)
# SENDGRID_API_KEY=
# EMAIL_FROM_ADDRESS=noreply@example.com

# Communications channels (Twilio SMS / WhatsApp)
# PUBLIC_API_BASE_URL=http://localhost:3000
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_SMS_MESSAGING_SERVICE_SID=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WEBHOOK_SIGNATURE_MODE=compat
# INBOUND_WEBHOOK_SECRET=

# Frontend (build-time)
# VITE_GOOGLE_MAPS_API_KEY=

# CORS
# CORS_ORIGIN=https://abbeygate.facio.io

# Payment provider (CardCorp / OPPWA)
# CARDCORP_ENTITY_ID=
# CARDCORP_BEARER_TOKEN=
# CARDCORP_BASE_URL=https://eu-test.oppwa.com

# Compliance provider (Creditsafe sanctions screening)
# CREDITSAFE_ENABLED=true
# CREDITSAFE_BASE_URL=https://connect.creditsafe.com/v1
# CREDITSAFE_USERNAME=
# CREDITSAFE_PASSWORD=
# CREDITSAFE_TIMEOUT_MS=10000
# CREDITSAFE_THRESHOLD=90
# Comma-separated AML categories. Leave unset to use the full default
# set (SAN-CURRENT,SAN-FORMER,PEP-CURRENT,PEP-FORMER,PEP-LINKED,AM,ENF,
# INS,DD,POI) — see backend/modules/compliance/app/serviceFactory.ts.
# Override only for testing / narrower runs (the smoke script defaults
# to SAN-CURRENT only).
# CREDITSAFE_DATASETS=
# Non-credit datasets that can block online purchase after exact DOB match.
# Leave unset to block on SAN-*,PEP-*,AM,ENF,POI; INS/DD are credit-only.
# CREDITSAFE_BLOCKING_DATASETS=

# Document generation
# FRONTEND_URL=http://localhost:5173
TEMPLATE_UPLOAD_MODE=storage
# DOCGEN_CERTIFICATE_TEMPLATE_PATH=
# DOCGEN_QUOTE_TEMPLATE_PATH=
# DOCGEN_INVOICE_TEMPLATE_PATH=

# Observability
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# SENTRY_DSN=
# VITE_SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# VITE_SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# VITE_SENTRY_RELEASE=
# SENTRY_ERROR_SAMPLE_RATE=1
# VITE_SENTRY_ERROR_SAMPLE_RATE=1
# SENTRY_TRACES_SAMPLE_RATE=1
# VITE_SENTRY_TRACES_SAMPLE_RATE=1
# VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
# VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1
# SENTRY_SEND_DEFAULT_PII=false
# VITE_SENTRY_SEND_DEFAULT_PII=false
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Workers
# QUEUE_WORKERS_ENABLED=true
# WORKER_CONCURRENCY=2

# Prisma tuning
# PRISMA_CONNECTION_LIMIT=10
# PRISMA_POOL_TIMEOUT=10
# PRISMA_QUERY_TIMING=false
# PRISMA_SLOW_QUERY_MS=200

# Backup / restore validation
# BACKUP_SOURCE_DATABASE_URL=
# BACKUP_RESTORE_DATABASE_URL=
# BACKUP_ARTIFACT_DIR=/tmp
# BACKUP_VALIDATE_REPORT_PATH=/tmp/backup-restore-validation.json
# BACKUP_RESTORE_APP_HEALTHCHECK_URL=https://restore-target.example.com/health
# BACKUP_RESTORE_SMOKE_COMMAND=bash ./tools/quality/aks/smoke-checks.sh

# Rollback drill
# PREVIOUS_RELEASE_TAG=
# ROLLBACK_TRIGGER=tenant_isolation_test_failed
# ROLLBACK_DRILL_REPORT_PATH=/tmp/rollback-drill.json
# ROLLBACK_SMOKE_COMMAND=bash ./tools/quality/aks/smoke-checks.sh
# ROLLBACK_RUN_REAL_BACKUP_VALIDATE=false

# Backup posture contract (production / CI)
# AKS_POSTGRES_SERVER_NAME=
# AKS_STORAGE_ACCOUNT_NAME=
# AKS_KEYVAULT_NAME=
# AKS_REDIS_NAME=
# REDIS_RECOVERY_MODE=disposable
# REDIS_PERSISTENCE_EVIDENCE=
# BACKUP_POLICY_LAST_RESTORE_VALIDATED_AT=2026-03-19T00:00:00Z
# MIN_POSTGRES_BACKUP_RETENTION_DAYS=35
# MIN_BLOB_DELETE_RETENTION_DAYS=30
# MIN_BLOB_CONTAINER_DELETE_RETENTION_DAYS=30
# MAX_RESTORE_VALIDATION_AGE_DAYS=30
# REQUIRE_POSTGRES_GEO_REDUNDANT_BACKUP=false
# REQUIRE_BLOB_VERSIONING=true
# REQUIRE_BLOB_CHANGE_FEED=true
# REQUIRE_KEYVAULT_PURGE_PROTECTION=true
# BACKUP_POSTURE_REPORT_PATH=/tmp/backup-posture.json
