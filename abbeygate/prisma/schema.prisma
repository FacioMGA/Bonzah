// --- COMMUNICATIONS (GEN2) ---

model CommunicationThread {
  id             String   @id @default(uuid())
  entityType     String // CLAIM, POLICY, PARTY, CASE, QUOTE, INVOICE
  entityId       String
  primaryPartyId String?
  status         String   @default("OPEN") // OPEN | CLOSED
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())

  messages CommunicationMessage[]

  @@index([entityType, entityId])
  @@map("communication_threads")
}

model CommunicationMessage {
  id                String              @id @default(uuid())
  threadId          String
  thread            CommunicationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  direction         String // OUTBOUND | INBOUND | INTERNAL
  channel           String // WHATSAPP | EMAIL | SMS | PHONE_CALL | NOTE | INTERNAL_CHAT | SYSTEM
  provider          String // SYSTEM | SENDGRID | MAILGUN | TWILIO | META_WHATSAPP | MANUAL
  communicationType String              @default("EXTERNAL") // EXTERNAL | INTERNAL_NOTE | SYSTEM_EVENT
  fromActor         String // User ID or "SYSTEM"
  toRecipients      Json                @db.JsonB // Array of contacts/emails/phones
  subject           String?
  body              String              @db.Text
  attachments       Json?               @db.JsonB // Array of file references
  externalRefs      Json?               @db.JsonB // Provider message IDs
  status            String              @default("QUEUED") // QUEUED | SENT | DELIVERED | FAILED | RECEIVED | LOGGED | DRAFT_PENDING_APPROVAL
  idempotencyKey    String?

  sentAt      DateTime?
  deliveredAt DateTime?
  receivedAt  DateTime?
  createdAt   DateTime  @default(now())

  deliveryAttempts CommunicationDeliveryAttempt[]

  @@unique([threadId, idempotencyKey])
  @@index([threadId])
  @@index([channel])
  @@index([status])
  @@index([communicationType])
  @@index([idempotencyKey])
  @@map("communication_messages")
}

model CommunicationTemplate {
  id               String  @id @default(uuid())
  name             String
  channel          String // EMAIL, SMS, WHATSAPP, etc.
  language         String  @default("en")
  subjectTemplate  String?
  bodyTemplate     String  @db.Text
  variablesSchema  Json    @db.JsonB // Allowed variables
  ownership        String  @default("GLOBAL") // GLOBAL | TENANT | USER
  enabled          Boolean @default(true)
  approvalRequired Boolean @default(false)
  tags             Json?   @db.JsonB // e.g., ["fnol", "missing-docs"]

  // Versioning + approval governance (email-safety Phase 3). A DB-backed row
  // may only OVERRIDE the shipped code design when approvalStatus == 'APPROVED';
  // an unapproved/stale row must never silently reach a customer.
  version         Int       @default(1)
  approvalStatus  String    @default("DRAFT") // DRAFT | APPROVED | REJECTED
  approvedBy      String?
  approvedAt      DateTime?
  lastEditor      String?
  lastDeployedSha String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("communication_templates")
}

// Persistent audit trail for SYNTHETIC email runs (issuance-proof canary,
// preview "send test"). Every synthetic dispatch leaves a row so we can prove
// what was sent, to whom, from which deploy, and whether any created artefacts
// still need cleaning up (email-safety Phase 3).
model SyntheticEmailRun {
  id              String   @id @default(uuid())
  deployedSha     String   @default("unknown")
  trigger         String
  templateKey     String
  templateVersion Int?
  // The originating CommunicationMessage id. The outbound delivery worker uses
  // it to finalise `result` (SENT/DELIVERED/FAILED) + provider delivery id once
  // the message actually reaches the provider, so the audit is not stuck at QUEUED.
  messageId       String?
  // Operating tenant (jurisdiction) that produced this synthetic run, captured
  // from the ALS context at dispatch so CY/PT/GR/ES canary evidence is
  // distinguishable and a tenant-safe reporting reader is possible.
  operatingTenantId String?
  recipients      Json     @db.JsonB // string[]
  deliveryIds     Json?    @db.JsonB // messageId(s) / provider ids
  result          String   @default("QUEUED") // QUEUED | SENT | DELIVERED | FAILED | SKIPPED
  resultDetail    String?
  cleanupStatus   String   @default("NOT_REQUIRED") // NOT_REQUIRED | PENDING | DONE | FAILED
  cleanupDetail   String?
  source          String?
  correlationId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([createdAt])
  @@index([trigger])
  @@index([messageId])
  @@index([operatingTenantId])
  @@map("synthetic_email_runs")
}

// --- COMMUNICATIONS: PARTICIPANTS ---

model CommunicationParticipant {
  id          String   @id @default(uuid())
  entityType  String // POLICY | CLAIM | ACCOUNT
  entityId    String
  contactName String
  contactRole String // POLICYHOLDER | BROKER | ADJUSTER | UNDERWRITER | INTERNAL | CLAIMANT | INSURED | PAYER
  email       String?
  phone       String?
  preferred   String? // EMAIL | SMS | WHATSAPP
  consent     Json?    @db.JsonB // { email: true, sms: false, whatsapp: true }
  meta        Json?    @db.JsonB // org, title, notes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([email])
  @@map("communication_participants")
}

// --- COMMUNICATIONS: DELIVERY TRACKING ---

// ---------------------------------------------------------------------------
// Tenant — MGA / jurisdiction entity
// ---------------------------------------------------------------------------

enum TenantKind {
  PRODUCTION
  SYNTHETIC
  TEST
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Tenant {
  id                           String       @id @default(uuid())
  tenantSlug                   String       @unique
  kind                         TenantKind   @default(PRODUCTION)
  status                       TenantStatus @default(ACTIVE)
  countryCode                  String // "CY" | "PT" | "GR" | "ES"
  country                      String
  currency                     String       @default("EUR")
  iptJson                      Json         @map("ipt") @db.JsonB
  adminFee                     Decimal      @default(0) @db.Decimal(10, 2)
  legalPack                    String // "cy" | "pt" | "gr" | "es"
  publicBaseUrl                String
  fromEmail                    String
  brandLogos                   Json?        @db.JsonB
  // regionConfig replacements
  priorityCountries            String[]
  allowedRiskCountries         String[]
  defaultNationality           String
  defaultDriversLicenseCountry String
  defaultBrokerName            String?
  // reserved for Sprint 4 authority extraction
  authority                    Json?        @db.JsonB
  // reserved for multi-MGA org grouping
  parentOrganizationId         String?

  // Sprint 2 back-relations (low-risk operational tables)
  recoEvents            RecoEvent[]            @relation("RecoEventTenant")
  recoBanditArms        RecoBanditArm[]        @relation("RecoBanditArmTenant")
  sanctionScreeningRuns SanctionScreeningRun[] @relation("SanctionScreeningRunTenant")
  policySearchIndexes   PolicySearchIndex[]    @relation("PolicySearchIndexTenant")
  policyListIndexes     PolicyListIndex[]      @relation("PolicyListIndexTenant")
  outboxEntries         Outbox[]               @relation("OutboxTenant")
  auditActions          AuditAction[]          @relation("AuditActionTenant")
  apiKeys               ApiKey[]               @relation("ApiKeyTenant")
  webhookEndpoints      WebhookEndpoint[]      @relation("WebhookEndpointTenant")

  // Sprint 3 back-relations (core business tables)
  accounts                       Account[]                       @relation("AccountOperatingTenant")
  policies                       Policy[]                        @relation("PolicyOperatingTenant")
  riskTransactions               RiskTransaction[]               @relation("RiskTransactionOperatingTenant")
  endorsements                   Endorsement[]                   @relation("EndorsementOperatingTenant")
  endorsementInstances           EndorsementInstance[]           @relation("EndorsementInstanceOperatingTenant")
  documents                      Document[]                      @relation("DocumentOperatingTenant")
  documentSets                   DocumentSet[]                   @relation("DocumentSetOperatingTenant")
  invoices                       Invoice[]                       @relation("InvoiceOperatingTenant")
  payments                       Payment[]                       @relation("PaymentOperatingTenant")
  reconciliations                Reconciliation[]                @relation("ReconciliationOperatingTenant")
  claims                         Claim[]                         @relation("ClaimOperatingTenant")
  claimAssignments               ClaimAssignment[]               @relation("ClaimAssignmentOperatingTenant")
  claimEvents                    ClaimEvent[]                    @relation("ClaimEventOperatingTenant")
  claimReserveTransactions       ClaimReserveTransaction[]       @relation("ClaimReserveTransactionOperatingTenant")
  binders                        Binder[]                        @relation("BinderOperatingTenant")
  binderProductAuthorities       BinderProductAuthority[]        @relation("BinderProductAuthorityOperatingTenant")
  programs                       Program[]                       @relation("ProgramOperatingTenant")
  programRatingModels            ProgramRatingModel[]            @relation("ProgramRatingModelOperatingTenant")
  policyHolders                  PolicyHolder[]                  @relation("PolicyHolderOperatingTenant")
  entities                       Entity[]                        @relation("EntityOperatingTenant")
  accountActivityFeeds           AccountActivityFeed[]           @relation("AccountActivityFeedOperatingTenant")
  accountAlertsProjections       AccountAlertsProjection[]       @relation("AccountAlertsProjectionOperatingTenant")
  accountIntelligenceProjections AccountIntelligenceProjection[] @relation("AccountIntelligenceProjectionOperatingTenant")
  accountSummaryProjections      AccountSummaryProjection[]      @relation("AccountSummaryProjectionOperatingTenant")
  accountPortfolioMetrics        AccountPortfolioMetrics[]       @relation("AccountPortfolioMetricsOperatingTenant")
  claimProjectionSnapshots       ClaimProjectionSnapshot[]       @relation("ClaimProjectionSnapshotOperatingTenant")
  claimMemoryProjections         ClaimMemoryProjection[]         @relation("ClaimMemoryProjectionOperatingTenant")
  policyStateCurrent             PolicyStateCurrent[]            @relation("PolicyStateCurrentOperatingTenant")
  policyQuoteHistories           PolicyQuoteHistory[]            @relation("PolicyQuoteHistoryOperatingTenant")
  bdxImportJobs                  BdxImportJob[]                  @relation("BdxImportJobTenant")

  // Behavior Layer
  behaviorEvents     BehaviorEvent[]    @relation("BehaviorEventTenant")
  policyTrajectories PolicyTrajectory[] @relation("PolicyTrajectoryTenant")

  // Config MCP V1 (ADR-0037) — product launch staging
  productLaunchDrafts           ProductLaunchDraft[]           @relation("ProductLaunchDraftTenant")
  // MCP OAuth 2.1 (V2.1) — ADR-0040.
  oauthClients                  OAuthClient[]                  @relation("OAuthClientTenant")
  // Product channel switches (ADR-0046) — public journey gates per product.
  productChannelSettings        ProductChannelSetting[]        @relation("ProductChannelSettingTenant")
  officeStaffTargets            OfficeStaffTarget[]            @relation("OfficeStaffTargetTenant")
  policyAssignments             PolicyAssignment[]             @relation("PolicyAssignmentTenant")
  personnelFiles                PersonnelFile[]                @relation("PersonnelFileTenant")
  staffAbsences                 StaffAbsence[]                 @relation("StaffAbsenceTenant")
  staffPayslips                 StaffPayslip[]                 @relation("StaffPayslipTenant")
  staffDiaryEntries             StaffDiaryEntry[]              @relation("StaffDiaryEntryTenant")
  staffMessages                 StaffMessage[]                 @relation("StaffMessageTenant")
  loginEvents                   LoginEvent[]                   @relation("LoginEventTenant")
  motorMarketSubmissions        MotorMarketSubmission[]        @relation("MotorMarketSubmissionTenant")
  motorMarketSubmissionAttempts MotorMarketSubmissionAttempt[] @relation("MotorMarketSubmissionAttemptTenant")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantSlug])
  @@index([status])
  @@map("tenants")
}

// ---------------------------------------------------------------------------

model CommunicationDeliveryAttempt {
  id          String               @id @default(uuid())
  messageId   String
  message     CommunicationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  provider    String // SENDGRID | TWILIO | META_WHATSAPP | SMTP
  channel     String // EMAIL | SMS | WHATSAPP
  status      String // QUEUED | SENDING | SENT | DELIVERED | BOUNCED | FAILED
  externalId  String? // Provider-specific message ID
  errorCode   String?
  errorDetail String?
  attemptedAt DateTime             @default(now())
  resolvedAt  DateTime?

  @@index([messageId])
  @@index([status])
  @@map("communication_delivery_attempts")
}

// ---------------------------------------------------------------------------
// Config MCP V1 — Product launch staging (ADR-0037)
// ---------------------------------------------------------------------------
// Workflow object only — NOT a canonical configuration source. Drafts stage
// natural-language-driven configuration changes from the Config MCP Product
// Architect agent. On publish, `publishToSandbox` translates `delta` into
// writes against canonical rows (Program.metadata, BinderProductAuthority,
// BinderFinancials, Tenant.adminFee). After publish the draft becomes
// evidence-only; no runtime consumer reads it.
//
// Single owner: `backend/modules/configuration/`. Enforced by
// `tools/quality/check-product-launch-draft-isolation.mjs`.
model ProductLaunchDraft {
  id                 String   @id @default(uuid())
  operatingTenantId  String
  operatingTenant    Tenant   @relation("ProductLaunchDraftTenant", fields: [operatingTenantId], references: [id])
  name               String
  baseTemplateId     String
  productCode        String // 'MOTOR' for V1
  status             String   @default("draft")
  // draft | validation_failed | validated | simulated | sandbox_published | archived
  delta              Json     @db.JsonB
  publishedProgramId String?
  publishedBinderId  String?
  createdByUserId    String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([operatingTenantId, status])
  @@index([operatingTenantId, productCode])
  @@map("product_launch_drafts")
}

// ---------------------------------------------------------------------------
// Product channel switches (ADR-0046)
// ---------------------------------------------------------------------------
// Per operating-tenant (== operating country) x product, three independent
// switches that gate the public customer journey:
//   - questionsEnabled → can the public open/fill the quote wizard
//   - quoteEnabled     → can the public see a price / run rating
//   - paymentEnabled   → can the public pay online (CardCorp checkout)
//
// Backend is the single source of truth; the public frontend reads a
// read-only projection via GET /api/public/product-channels. A logged-in
// Back Office user bypasses any OFF gate (enforced server-side). Tenant-scoped
// via the Prisma extension + RLS (ADR-0019).
//
// Single owner: `backend/modules/policy/app/productChannel/`.
model ProductChannelSetting {
  id                String   @id @default(uuid())
  operatingTenantId String
  operatingTenant   Tenant   @relation("ProductChannelSettingTenant", fields: [operatingTenantId], references: [id])
  productCode       String // 'MOTOR' | 'HOME' | 'TRAVEL' | 'HEALTH' | 'BUSINESS' | 'OPEN_MARKET'
  questionsEnabled  Boolean  @default(true)
  quoteEnabled      Boolean  @default(true)
  paymentEnabled    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([operatingTenantId, productCode])
  @@index([operatingTenantId])
  @@map("product_channel_settings")
}

