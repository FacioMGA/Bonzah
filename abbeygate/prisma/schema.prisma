model PolicyListIndex {
  policyId                String    @id
  policy                  Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  operatingTenantId       String
  operatingTenant         Tenant    @relation("PolicyListIndexTenant", fields: [operatingTenantId], references: [id])
  policyNumber            String
  insuredName             String
  insuredDisplay          String?   @map("insured_display")
  vehicleDisplay          String?   @map("vehicle_display")
  policyholderDisplay     String?   @map("policyholder_display")
  policyholderEmail       String?   @map("policyholder_email")
  policyholderPhone       String?   @map("policyholder_phone")
  coverageStart           DateTime? @map("coverage_start")
  coverageEnd             DateTime? @map("coverage_end")
  status                  String
  bo_status               String?   @map("bo_status")
  vehicleSearch           String?   @map("vehicle_search")
  address                 String?
  segment                 String?
  totalPremium            Decimal   @default(0)
  // Compatibility with existing list sort/display semantics.
  updatedAt               DateTime  @default(now())
  renewalDate             DateTime?
  quoteExpiryDate         DateTime?
  // Dedicated SoR list signals.
  lastActivityAt          DateTime  @default(now())
  attentionBucket         String    @default("NORMAL")
  attentionScore          Int       @default(0)
  // Categorical status ordering for BO table sorting.
  statusSortRank          Int       @default(999)
  bo_statusSortRank       Int?      @map("bo_status_sort_rank")
  hasOpenClaim            Boolean   @default(false)
  openClaimCount          Int       @default(0)
  outstandingBalance      Decimal   @default(0)
  invoiceOverdue          Boolean   @default(false)
  cancellationPending     Boolean   @default(false)
  customerActionRequired  Boolean   @default(false)
  uwActionRequired        Boolean   @default(false)
  complianceState         String    @default("PASS")
  complianceProfile       String    @default("PRODUCTION_STRICT")
  complianceReasons       Json?     @db.JsonB
  complianceCheckedAt     DateTime?
  // SLA 3: tracks when bo_status last changed, enabling referral-age queries.
  bo_status_changed_at    DateTime? @map("bo_status_changed_at")
  // OPERATIONS EUR: pro-rata unearned premium for cancellation-pending policies.
  cancellationExposureEUR Decimal?  @map("cancellation_exposure_eur")
  indexUpdatedAt          DateTime  @updatedAt
  indexVersion            Int       @default(1)

  @@index([status])
  @@index([bo_status])
  @@index([vehicleSearch])
  @@index([attentionScore, lastActivityAt(sort: Desc)])
  @@index([statusSortRank])
  @@index([bo_statusSortRank])
  @@index([lastActivityAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
  @@index([renewalDate])
  @@index([quoteExpiryDate])
  @@index([policyNumber])
  @@index([totalPremium])
  @@index([outstandingBalance])
  @@index([invoiceOverdue])
  @@index([cancellationPending])
  @@index([hasOpenClaim])
  @@index([customerActionRequired])
  @@index([uwActionRequired])
  @@index([complianceState])
  // SLA 3 index: find REFERRAL rows by when the status was entered.
  @@index([bo_status, bo_status_changed_at])
  @@index([operatingTenantId])
  // Tenant-aware keyset paths for the BO list (PR3 of policies-list-perf).
  // Default sort + keyset tie-break — see docs/architecture/contracts/database-indexes.md.
  // Explicit `map:` keeps the schema, migration SQL, and indexBootstrap names in lockstep.
  @@index([operatingTenantId, attentionScore(sort: Desc), lastActivityAt(sort: Desc), policyNumber(sort: Desc), policyId(sort: Desc)], map: "policy_list_index_tenant_default_sort_keyset_idx")
  @@index([operatingTenantId, lastActivityAt(sort: Desc), policyId(sort: Desc)], map: "policy_list_index_tenant_lastactivity_keyset_idx")
  @@map("policy_list_index")
}

