// Lloyd's-grade per-product authorization on a binder.
// A binder "authorizes" a product (line of business) only when a row exists here.
// Drives BDX class-of-business/risk-code segmentation and policy binding validation.
model BinderProductAuthority {
  id                String            @id @default(uuid())
  operatingTenantId String
  operatingTenant   Tenant            @relation("BinderProductAuthorityOperatingTenant", fields: [operatingTenantId], references: [id])
  binderId          String
  binder            Binder            @relation(fields: [binderId], references: [id], onDelete: Cascade)
  productCode       String
  productDefinition ProductDefinition @relation(fields: [productCode], references: [code])

  // Lloyd's reporting codes (per product, for V5.2 CRS column mapping)
  classOfBusiness String // e.g. "MOTOR", "PROPERTY", "TRAVEL"
  riskCode        String? // Lloyd's risk code (e.g. "MC", "HH", "TE")

  // Underwriting authority (per product)
  territorialScope        String[] @default([]) // ISO-3166 alpha-2 codes
  maxPremiumAnnual        Decimal? @db.Decimal(14, 2)
  maxPolicyPeriodDays     Int?
  maxAdvanceInceptionDays Int?
  authorityClasses        String[] @default([]) // e.g. ["TPBI","TPPD","OD"]

  status        String    @default("ACTIVE") // ACTIVE | SUSPENDED
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([binderId, productCode])
  @@index([operatingTenantId])
  @@index([binderId])
  @@index([productCode])
  @@index([status])
  @@map("binder_product_authorities")
}

// Immutable append-only audit of every rate event (quote, rate, endorsement-rate, cancellation-rate).
// Primary purpose: deterministic debugging + BDX reconciliation.
model PriceCalculationAudit {
  id                String   @id @default(uuid())
  policyId          String?
  policy            Policy?  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  riskTransactionId String?
  quoteId           String?
  productType       String
  calculatorVersion String
  inputs            Json     @db.JsonB
  steps             Json     @db.JsonB
  totalPremium      Decimal  @db.Decimal(14, 2)
  policyExcess      Decimal? @db.Decimal(14, 2)
  currency          String
  reproHash         String
  eventKind         String // 'QUOTE' | 'RATE' | 'ENDORSEMENT_RATE' | 'CANCELLATION_RATE'
  createdAt         DateTime @default(now())
  createdBy         String?

  @@index([policyId, createdAt(sort: Desc)])
  @@index([reproHash])
  @@index([productType])
  @@index([quoteId])
  @@map("price_calculation_audits")
}

model ReportingPeriod {
  id        String    @id @default(uuid())
  binderId  String?
  binder    Binder?   @relation(fields: [binderId], references: [id])
  year      Int
  month     Int
  startDate DateTime
  endDate   DateTime
  status    String // OPEN, LOCKED, SUBMITTED
