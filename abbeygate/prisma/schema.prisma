// --- GEN2 COMPLIANCE CORE ---

model Binder {
  id                 String  @id @default(uuid())
  operatingTenantId  String
  operatingTenant    Tenant  @relation("BinderOperatingTenant", fields: [operatingTenantId], references: [id])
  coverholderName    String
  coverholderPin     String?
  umr                String // Unique Market Reference (e.g., B6081 ABBEYGATE0125)
  agreementNumber    String // e.g., ABBEYGATE0125
  lloydsReportingVer String  @default("V5.2")
  defaultCurrency    String  @default("USD")
  settlementCurrency String  @default("USD")
  // Magic-B binder workstation config (JSON pointers) + optimistic concurrency
  config             Json?   @db.JsonB
  version            Int     @default(1)
  etag               String? @default(uuid())

  startDate DateTime?
  endDate   DateTime?
  status    String    @default("DRAFT")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policies           Policy[]
  reportingPeriods   ReportingPeriod[] // Binder-specific reporting cycles
  riskTransactions   RiskTransaction[]
  documents          BinderDocument[]
  parties            BinderParty[]
  coverages          BinderCoverage[]
  clauses            BinderClause[]
  financials         BinderFinancials?
  reportingConfig    BinderReporting?
  programLinks       ProgramBinderLink[]
  productAuthorities BinderProductAuthority[]

  @@index([operatingTenantId])
  @@map("binders")
}

model BinderDocument {
  id       String @id @default(uuid())
  binderId String
  binder   Binder @relation(fields: [binderId], references: [id], onDelete: Cascade)

  type       String // agreement | endorsement | wording | ipid | appendix
  name       String
  filename   String?
  storageUri String
  mimeType   String?
  sizeBytes  Int?
  meta       Json?   @db.JsonB

  uploadedAt DateTime @default(now())
  uploadedBy String?

  @@index([binderId])
  @@index([type])
  @@map("binder_documents")
}

model BinderParty {
  id       String @id @default(uuid())
  binderId String
  binder   Binder @relation(fields: [binderId], references: [id], onDelete: Cascade)

  role         String // appointed_coverholder | lloyds_broker | managing_agent | tpa | operation_control | authorised_to_bind | document_responsible | claims_authority
  partySubtype String?

  name               String
  registrationNumber String?
  address            Json?   @db.JsonB
  contact            Json?   @db.JsonB
  rolesMeta          Json?   @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([binderId])
  @@index([role])
  @@map("binder_parties")
}

model BinderCoverage {
  id       String @id @default(uuid())
  binderId String
  binder   Binder @relation(fields: [binderId], references: [id], onDelete: Cascade)

  coverageCode          String
  title                 String?
  allowed               Boolean       @default(true)
  maxLimit              Json?         @db.JsonB
  deductible            Json?         @db.JsonB
  partyLimits           Json?         @db.JsonB
  wordingAnchorClauseId String?
  wordingAnchorClause   BinderClause? @relation("BinderCoverageWordingAnchor", fields: [wordingAnchorClauseId], references: [id], onDelete: SetNull)
  meta                  Json?         @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([binderId])
  @@index([coverageCode])
  @@map("binder_coverages")
}

model BinderClause {
  id                  String           @id @default(uuid())
  binderId            String
  binder              Binder           @relation(fields: [binderId], references: [id], onDelete: Cascade)
  wordingForCoverages BinderCoverage[] @relation("BinderCoverageWordingAnchor")

  clauseType   String // authority | claims | wording | exclusion | reporting | other
  textFragment String
  pointer      Json?    @db.JsonB // {page, offset, ...}
  codes        String[] // e.g. ["LBS0047A","LMA5441"]
  meta         Json?    @db.JsonB // confidence, sourceDocId, etc

