  updatedAt DateTime @updatedAt

  @@index([binderId])
  @@index([clauseType])
  @@map("binder_clauses")
}

model BinderFinancials {
  binderId String @id
  binder   Binder @relation(fields: [binderId], references: [id], onDelete: Cascade)

  maxLine           Decimal? @default(0)
  grossPremiumLimit Decimal? @default(0)
