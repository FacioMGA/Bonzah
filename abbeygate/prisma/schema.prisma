generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Azure App Service Linux containers typically run on OpenSSL 3.
  // Include it explicitly so the query engine matches the runtime.
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  name            String?
  firstName       String?
  lastName        String?
  role            Role      @default(UNDERWRITER)
  userType        UserType  @default(INTERNAL)
  password        String
  isActive        Boolean   @default(true)
  mfaEnabled      Boolean   @default(false)
  phone           String?
  tokenVersion    Int       @default(0)
  lastLogin       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Invitation lifecycle
  invitedById     String?
  invitedBy       User?     @relation("InvitedUsers", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers    User[]    @relation("InvitedUsers")
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?

  // Suspension
  suspendedAt     DateTime?
  suspendedReason String?

  // Ownership + onboarding
  primaryAccountId  String?
  primaryAccount    Account?           @relation("UserPrimaryAccount", fields: [primaryAccountId], references: [id], onDelete: SetNull)
  accountUsers      AccountUser[]
  otps              UserOtp[]
  accessAssignments AccessAssignment[]

  @@map("users")
}

enum Role {
  ADMIN
  UNDERWRITER
  CUSTOMER
}

enum UserType {
  INTERNAL
  BROKER
  CUSTOMER
  PARTNER
}

enum AccessRoleType {
  SYSTEM
  CUSTOM
}

enum ScopeType {
  GLOBAL
  PRODUCT
  BINDER
  OWN_RECORDS
}

model AccessRole {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  type        AccessRoleType @default(CUSTOM)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  permissions RolePermission[]
  assignments AccessAssignment[]

  @@map("access_roles")
}

model Permission {
  id          String  @id @default(uuid())
  resource    String
  action      String
  displayName String
  description String?
  constraints Json?   @db.JsonB

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  constraints  Json?  @db.JsonB

  role       AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AccessAssignment {
  id           String    @id @default(uuid())
  userId       String
  roleId       String
  scopeType    ScopeType @default(GLOBAL)
  scopeValue   String?
  assignedById String?
  assignedAt   DateTime  @default(now())
  expiresAt    DateTime?

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, scopeValue])
  @@index([userId])
  @@map("access_assignments")
}

enum AccountUserRole {
  OWNER
  MEMBER
}

enum AccountKind {
  CUSTOMER
  INTERNAL
}

enum EntityType {
  PERSON
  ORGANIZATION
  VEHICLE
  ASSET
}

enum UserOtpPurpose {
  EMAIL_VERIFICATION
  LOGIN
  PASSWORD_RESET
}

model Account {
  id                String      @id @default(uuid())
  operatingTenantId String
  operatingTenant   Tenant      @relation("AccountOperatingTenant", fields: [operatingTenantId], references: [id])
  name              String?
  kind              AccountKind @default(CUSTOMER)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  users            AccountUser[]
  policies         Policy[]
  entities         Entity[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]

  // Back-reference for User.primaryAccount
  primaryUsers User[] @relation("UserPrimaryAccount")

  @@index([operatingTenantId])
  @@map("accounts")
}

model ApiKey {
  id                String    @id @default(uuid())
  operatingTenantId String
  operatingTenant   Tenant    @relation("ApiKeyTenant", fields: [operatingTenantId], references: [id])
  keyHash           String    @unique
  name              String
  accountId         String
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  isActive          Boolean   @default(true)
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime?
  // Per-key scoped permissions (ADR-0036 amendment for remote MCP access).
  // Empty array on legacy / non-MCP keys; MCP keys are populated at issuance
  // time from CONFIG_AGENT_BASELINE plus optional opt-ins.
  permissions       String[]  @default([])

  @@index([operatingTenantId])
  @@index([accountId])
  @@index([keyHash])
  @@map("api_keys")
}

model WebhookEndpoint {
  id                String   @id @default(uuid())
  operatingTenantId String
  operatingTenant   Tenant   @relation("WebhookEndpointTenant", fields: [operatingTenantId], references: [id])
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  url               String
  secret            String
  description       String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@index([operatingTenantId])
  @@index([accountId])
  @@map("webhook_endpoints")
}

model AccountUser {
  id        String          @id @default(uuid())
  accountId String
  userId    String
  role      AccountUserRole @default(MEMBER)
  createdAt DateTime        @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId])
  @@index([userId])
  @@index([accountId])
  @@map("account_users")
}

model Entity {
  id                String     @id @default(uuid())
  operatingTenantId String
  operatingTenant   Tenant     @relation("EntityOperatingTenant", fields: [operatingTenantId], references: [id])
  accountId         String?
  type              EntityType
  name              String?
  data              Json?      @db.JsonB
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  account         Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  insuredPolicies Policy[] @relation("PolicyInsuredEntity")

  @@index([operatingTenantId])
  @@index([accountId])
  @@index([type])
  @@map("entities")
}

model UserOtp {
  id         String         @id @default(uuid())
  userId     String?
  email      String
  purpose    UserOtpPurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int            @default(0)
  createdAt  DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
  @@index([expiresAt])
  @@map("user_otps")
}

model PolicyHolder {
  id                String   @id @default(uuid())
  operatingTenantId String
  operatingTenant   Tenant   @relation("PolicyHolderOperatingTenant", fields: [operatingTenantId], references: [id])
  name              String
  segment           String?
  address           String?
  contact           String?
  bankAccounts      Json?    @db.JsonB
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  policies          Policy[]

  @@index([operatingTenantId])
  @@map("policy_holders")
}

model AccountSummaryProjection {
  id                   String    @id @default(uuid())
  operatingTenantId    String
  operatingTenant      Tenant    @relation("AccountSummaryProjectionOperatingTenant", fields: [operatingTenantId], references: [id])
  accountId            String    @unique
  accountName          String
  accountType          String    @default("INDIVIDUAL")
  secondaryIdentity    String?
  ownerBroker          String?
  activePoliciesCount  Int       @default(0)
  openClaimsCount      Int       @default(0)
  outstandingBalance   Decimal   @default(0)
  annualizedPremium    Decimal   @default(0)
  renewalIn30DaysCount Int       @default(0)
  renewalIn60DaysCount Int       @default(0)
  billingIssueCount    Int       @default(0)
  healthStatus         String    @default("HEALTHY")
  healthScore          Int       @default(0)
  healthReasons        Json?     @db.JsonB
  healthRuleVersion    Int       @default(1)
  lastActivityAt       DateTime?
  lastActivityType     String?
  lastActivitySummary  String?
  productMix           Json?     @db.JsonB
  computedAt           DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([operatingTenantId])
  @@index([healthStatus])
  @@index([lastActivityAt])
  @@index([accountName])
  @@map("account_summary_projection")
}

model AccountPortfolioMetrics {
  id                     String   @id @default(uuid())
  operatingTenantId      String
  operatingTenant        Tenant   @relation("AccountPortfolioMetricsOperatingTenant", fields: [operatingTenantId], references: [id])
  accountId              String   @unique
  activePoliciesCount    Int      @default(0)
  draftPoliciesCount     Int      @default(0)
  expiredPoliciesCount   Int      @default(0)
  cancelledPoliciesCount Int      @default(0)
  annualizedPremium      Decimal  @default(0)
  productMix             Json?    @db.JsonB
  renewalBuckets         Json?    @db.JsonB
  computedAt             DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([operatingTenantId])
  @@index([annualizedPremium])
  @@map("account_portfolio_metrics")
}

model AccountAlertsProjection {
  id                String    @id @default(uuid())
  operatingTenantId String
  operatingTenant   Tenant    @relation("AccountAlertsProjectionOperatingTenant", fields: [operatingTenantId], references: [id])
  accountId         String
  alertCode         String
  severity          String
  title             String
  description       String?
  isOpen            Boolean   @default(true)
  sourceDomain      String
  sourceRefId       String?
  occurredAt        DateTime  @default(now())
  resolvedAt        DateTime?
  metadata          Json?     @db.JsonB
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([operatingTenantId])
  @@index([accountId, isOpen])
  @@index([accountId, severity])
  @@index([occurredAt])
  @@map("account_alerts_projection")
}

model AccountActivityFeed {
  id                String   @id @default(uuid())
  operatingTenantId String
  operatingTenant   Tenant   @relation("AccountActivityFeedOperatingTenant", fields: [operatingTenantId], references: [id])
  accountId         String
  sourceDomain      String
  eventType         String
  eventSummary      String
  aggregateType     String?
  aggregateId       String?
  occurredAt        DateTime
  metadata          Json?    @db.JsonB
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([operatingTenantId])
  @@index([accountId, occurredAt(sort: Desc)])
  @@index([sourceDomain, eventType])
  @@map("account_activity_feed")
}

model AccountIntelligenceProjection {
  id                  String    @id @default(uuid())
  operatingTenantId   String
  operatingTenant     Tenant    @relation("AccountIntelligenceProjectionOperatingTenant", fields: [operatingTenantId], references: [id])
  accountId           String    @unique
  accountName         String
  secondaryIdentity   String?
  searchTerms         String?
  activePolicies      Int       @default(0)
  totalPolicies       Int       @default(0)
  totalPremium        Decimal   @default(0)
  productMix          Json?     @db.JsonB
  openClaimsCount     Int       @default(0)
  outstandingReserve  Decimal   @default(0)
  overdueAmount       Decimal   @default(0)
  failedPaymentsCount Int       @default(0)
  nextRenewalAt       DateTime?
  lastActivityAt      DateTime?
  lastActivityType    String?
  lastActivitySummary String?
  state               String    @default("HEALTHY")
  stateReasons        Json?     @db.JsonB
  stateScore          Int?
  statePriority       Int       @default(4)
  computedAt          DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([operatingTenantId])
  @@index([state])
  @@index([statePriority, lastActivityAt(sort: Desc), accountId])
  @@index([nextRenewalAt])
  @@index([accountName])
  @@map("account_intelligence_projection")
}

model ProductDefinition {
  code              String                   @id
  displayName       String
  icon              String?
  isActive          Boolean                  @default(true)
  programs          Program[]
  binderAuthorities BinderProductAuthority[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@map("product_definitions")
}

model Program {
  id                String    @id @default(uuid())
  operatingTenantId String
  operatingTenant   Tenant    @relation("ProgramOperatingTenant", fields: [operatingTenantId], references: [id])
  name              String
  // Lifecycle status. Allowed values: DRAFT | ACTIVE | EXPIRED |
  // CANCELLED | ARCHIVED. EXPIRED may be set explicitly by ops or
  // derived at read time when `effectiveTo < now()`. Issuance is
  // blocked unless the program is ACTIVE and the policy's
  // inceptionDate falls within `[effectiveFrom, effectiveTo]`
  // (open-ended bounds = unconstrained on that side).
  status            String    @default("DRAFT")
  productType       String?
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  metadata          Json?     @db.JsonB

  productDefinition ProductDefinition?   @relation(fields: [productType], references: [code])
  ratingModels      ProgramRatingModel[]
  policies          Policy[]
  riskTransactions  RiskTransaction[]
  binderLinks       ProgramBinderLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatingTenantId])
  @@index([status])
  @@index([productType])
  @@map("programs")
}

model Policy {
  id                 String  @id @default(uuid())
  operatingTenantId  String
  operatingTenant    Tenant  @relation("PolicyOperatingTenant", fields: [operatingTenantId], references: [id])
  policyNumber       String
  // Public customer session identifier (unguessable). Replaces exposing policyNumber/UUID in public URLs.
  publicSessionToken String? @unique @map("public_session_token")
  // Motor: certificate numbering (issued at bind; immutable)
  certificateNumber  String? @unique
  // Motor: Green Card serial (global sequence; immutable once set)
  greenCardSerial    String? @unique
  // Gen2 locking + payment status projection
  isLocked           Boolean @default(false)
  paymentStatus      String  @default("NOT_REQUIRED") // NOT_REQUIRED | PENDING | PAID | FAILED
  issueReadiness     Json?   @db.JsonB // Tracks issuance progress (bound transaction, documents, welcome email)

  // Ownership
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // Normalized insured (new policies). Existing policies may keep insured/vehicle data in JSON.
  insuredEntityId String?
  insuredEntity   Entity? @relation("PolicyInsuredEntity", fields: [insuredEntityId], references: [id], onDelete: SetNull)

  programId            String?
  program              Program?          @relation(fields: [programId], references: [id])
  binderId             String?
  binder               Binder?           @relation(fields: [binderId], references: [id])
  renewalFamilyId      String            @default(uuid())
  renewalSequence      Int               @default(1)
  priorTermPolicyId    String?
  priorTermPolicy      Policy?           @relation("PolicyRenewalTermChain", fields: [priorTermPolicyId], references: [id], onDelete: SetNull)
  nextTermPolicies     Policy[]          @relation("PolicyRenewalTermChain")
  riskTransactions     RiskTransaction[]
  umr                  String?
  status               String
  bo_status            String?           @map("bo_status")
  inceptionDate        DateTime
  expiryDate           DateTime
  issuedAt             DateTime?
  currentEndorsementId String?
  policyHolderId       String

  // Product Type
  productType String? // MOTOR

  // =========================================================================================
  // SCHEMATIC GOVERNANCE WARNING (Multi-Product Extensibility):
  // DO NOT add new product-specific root columns to the Policy model!
  //
  // Future product-specific fields (e.g. for Home, Travel, Health) MUST be housed in:
  // 1. A generic JSON `productData` field, OR
  // 2. Dedicated 1-to-1 relations (e.g. `PolicyHomeDetails`, `PolicyTravelDetails`).
  //
  // The fields below are legacy Motor-specific columns and are slated for eventual 
  // extraction into a `PolicyMotorDetails` relation or generic JSON structure.
  // =========================================================================================

  // Auto Insurance specific fields (Legacy)
  vehicleInfo   Json? @db.JsonB // Vehicle details from quote
  driverInfo    Json? @db.JsonB // Driver/history information
  quoteData     Json? @db.JsonB // Full QuoteData snapshot
  quoteResponse Json? @db.JsonB // Full QuoteResponse snapshot

  // Typed Lloyd's reporting projections (Legacy Motor-specific)
  vehicleRegistrationCountry String?
  vehicleRegistrationNumber  String?
  vehicleTypeCode            String?
  coverTypeCode              String?
  excessAmount               Decimal?
  sumInsuredAmount           Decimal?
  originalCurrency           String?
  insuredCountry             String?

  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  claims                 Claim[]
  documents              Document[]
  endorsements           Endorsement[]
  endorsementInstances   EndorsementInstance[]
  policyHolder           PolicyHolder            @relation(fields: [policyHolderId], references: [id])
  invoices               Invoice[]
  payments               Payment[]
  reconciliations        Reconciliation[]
  stateCurrent           PolicyStateCurrent?
  searchIndex            PolicySearchIndex?
  listIndex              PolicyListIndex?
  assignment             PolicyAssignment?
  trajectory             PolicyTrajectory?
  quoteHistory           PolicyQuoteHistory[]
  documentSets           DocumentSet[]
  sanctionScreeningRuns  SanctionScreeningRun[]
  renewalEmailState      RenewalEmailState?
  calculationAudits      PriceCalculationAudit[]
  motorMarketSubmissions MotorMarketSubmission[]

  @@unique([policyNumber, renewalSequence])
  @@index([operatingTenantId])
  @@index([policyHolderId])
  @@index([accountId])
  @@index([insuredEntityId])
  @@index([programId])
  @@index([binderId])
  @@index([renewalFamilyId])
  @@index([priorTermPolicyId])
  @@index([renewalFamilyId, renewalSequence])
  @@index([status])
  @@index([bo_status])
  @@index([productType])
  @@index([inceptionDate])
  @@index([expiryDate])
  @@index([createdAt(sort: Desc)])
  @@map("policies")
}

model RenewalEmailState {
