// ---------------------------------------------------------------------------
// MCP OAuth 2.1 (V2.1 — ADR-0040)
// ---------------------------------------------------------------------------
// Two tables: clients (DCR registrations) + refresh tokens. Authorization
// codes and access tokens live in Redis (high read volume, short TTL) —
// same precedent as confirmationTokenStore.
//
// Per-tenant: every row is bound to operatingTenantId. The tenant-scoped
// Prisma extension enforces the boundary; cross-tenant reads/writes are
// impossible from app code.
//
// Single owner: `backend/modules/mcp/oauth/`. Direct Prisma writes from
// any other module fail the `check-mcp-auth-single-funnel.mjs` guard.

model OAuthClient {
  id                String @id @default(uuid())
  operatingTenantId String
  operatingTenant   Tenant @relation("OAuthClientTenant", fields: [operatingTenantId], references: [id])

  // RFC 7591 client_id — public identifier returned by DCR.
  // Format: `oauthc_<32hex>`. Used as the `client_id` URL param on
  // /oauth/authorize and as the `client_id` form field on /oauth/token.
  clientId String @unique

  // RFC 7591 client_secret HASH. NULL for public clients (ChatGPT
  // Apps, Claude Desktop with PKCE). Present for confidential clients.
  // The raw secret is returned ONCE from /oauth/register and never
  // stored — same posture as ApiKey.keyHash.
  clientSecretHash String?

  clientName String
  clientUri  String?

  // RFC 7591 redirect_uris. Validated at registration: HTTPS only
  // (except localhost in non-prod tenants), no wildcards, no query
  // strings, exact match required on /oauth/authorize.
  redirectUris String[]

  // Scopes this client may request at /oauth/authorize. A subset of
  // the global scopes_supported. Enforced at authorize time —
  // requesting outside this list is `invalid_scope`.
  scopes String[]

  // 'dcr' (RFC 7591 open registration) | 'predefined' (Facio-issued
  // in-the-BO, V3). V2.1 only ships 'dcr'.
  registrationKind String @default("dcr")

  createdAt DateTime  @default(now())
  revokedAt DateTime?

  refreshTokens OAuthRefreshToken[] @relation("OAuthRefreshTokenClient")

  @@index([operatingTenantId, revokedAt])
  @@index([clientId])
  @@map("oauth_clients")
}

model OAuthRefreshToken {
  id                String @id @default(uuid())
  operatingTenantId String

  // SHA-256 hash of the opaque `rt_<32hex>` value. Raw value lives only
  // in the OAuth client's local storage.
  tokenHash String @unique

  // FK by clientId not pkid (RFC 7591 semantics — clientId is the
  // stable cross-table reference; the OAuthClient.id pkid is internal).
  clientId String
  client   OAuthClient @relation("OAuthRefreshTokenClient", fields: [clientId], references: [clientId])

  // The BO user who granted consent. Audit trail for "who approved
  // what this client may do".
  userId String

  scopes   String[]
  resource String // RFC 8707 binding to the canonical MCP mount URL.

  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  // Set when this refresh token is used to mint a new one (rotation
  // chain). Once rotatedAt is non-null, the token is no longer
  // accepted.
  rotatedAt DateTime?
  revokedAt DateTime?

  @@index([operatingTenantId, expiresAt])
  @@index([clientId, expiresAt])
  @@index([tokenHash])
  @@map("oauth_refresh_tokens")
}
