// ClaimMemoryProjection (ADR-0041) — cached, async-refreshed claim memory.
// One row per claim. Written only by `backend/workers/handlers/CLAIM_MEMORY.REFRESH.ts`
// via `refreshClaimMemoryUseCase`. Read by Claim Workspace co-pilot and V1 operator
// MCP tools (`operator.get_claim_memory`, `operator.find_similar_claims`,
// `operator.analyze_claim_memory`, `operator.refresh_claim_memory`).
// Critical-path safe: if Neo4j or the LLM is down, the worker writes
// `refreshStatus='failed'` and the UI renders the prior row with a stale banner.
model ClaimMemoryProjection {
  id                String @id @default(uuid())
  operatingTenantId String
  operatingTenant   Tenant @relation("ClaimMemoryProjectionOperatingTenant", fields: [operatingTenantId], references: [id])
  claimId           String @unique
  claim             Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  // LLM-generated summary text + citation refs (back to `communication_messages`).
  // `summaryCitations` shape: [{ threadId, messageId, quote, charOffsetStart?, charOffsetEnd? }].
  summary          String? @db.Text
  summaryCitations Json?   @db.JsonB

  // Structured memory object — timeline, missingInformation, authorityFlags,
  // liabilityPositions, recommendedActions. Shape owned by
  // `backend/modules/claims/domain/mailgraph/claimMemoryObject.ts`.
  memoryObject Json @db.JsonB

  // Graph-derived enrichment — written after Neo4j upsert + similarity queries.
  // Empty arrays/objects when Neo4j is unavailable or before Week 2 lands.
  // `similarClaims` shape: [{ claimId, score, reasons[], evidenceCitationIds[] }].
  // `graphSignals` shape: { sharedRepairers[], sharedMissingDocPatterns[], escalationPatterns[] }.
  similarClaims Json @default("[]") @db.JsonB
  graphSignals  Json @default("{}") @db.JsonB

  // Lifecycle. `refreshStatus`: pending | refreshing | fresh | stale | failed.
  // `refreshError` is a short machine code (e.g. `neo4j_unavailable`).
  lastRefreshedAt DateTime?
  refreshStatus   String    @default("pending")
  refreshError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatingTenantId])
  @@index([operatingTenantId, refreshStatus])
  @@index([lastRefreshedAt])
  @@map("claim_memory_projections")
}

// ADR-0044 — Submission (underwriting) memory projection. Mirrors
// ClaimMemoryProjection but anchored to a Policy id (the submission).
// Sole writer: refreshSubmissionMemoryUseCase via SUBMISSION_MEMORY.REFRESH.
model SubmissionMemoryProjection {
  id                String @id @default(uuid())
  operatingTenantId String
  submissionId      String @unique // Policy.id treated as the submission

  summary          String? @db.Text
  summaryCitations Json?   @db.JsonB

  // Shape owned by backend/modules/policy/domain/submissionMemory/submissionMemoryObject.ts
  memoryObject Json @db.JsonB

  // Graph-derived enrichment.
  similarSubmissions Json @default("[]") @db.JsonB
  graphSignals       Json @default("{}") @db.JsonB

  lastRefreshedAt DateTime?
  refreshStatus   String    @default("pending")
  refreshError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatingTenantId])
  @@index([operatingTenantId, refreshStatus])
  @@index([lastRefreshedAt])
  @@map("submission_memory_projections")
}

// ADR-0044 — durable log of every Org2Vec email ingestion + the business
