  @@map("bdx_import_job_results")
}

// ── Behavior Layer ────────────────────────────────────────────────────────────
// Append-only, semantic representation of meaningful changes. Sits between the
// raw Outbox (append-only, technical) and the per-entity Trajectory projection.
//
// Manifesto: behaviorEvents preserve MOVEMENT (what happened, when, in what
// order, with what gap). They are NEVER mutated. Trajectory is DERIVED.
model BehaviorEvent {
  id                       String                       @id @default(uuid())
  operatingTenantId        String
  operatingTenant          Tenant                       @relation("BehaviorEventTenant", fields: [operatingTenantId], references: [id])
  entityType               String // current canonical entity type: "POLICY"
  entityId                 String
  behaviorType             String // e.g. "policy.payment_failed"
  canonicalText            String // human-readable rendering used as the embedding source
  occurredAt               DateTime
  deltaMsFromPreviousEvent BigInt? // gap from the entity's previous BehaviorEvent (durable for cadence/scoring)
  sourceEventId            String                       @unique // outbox eventId — idempotency
  payload                  Json?                        @db.JsonB
  embedding                Unsupported("vector(1536)")? // embedding of canonicalText
  createdAt                DateTime                     @default(now())

  @@index([operatingTenantId])
  @@index([entityType, entityId, occurredAt])
  @@map("behavior_events")
}

// Per-entity Trajectory projection. Fast-read, regenerable from BehaviorEvent.
//
// trajectoryEmbedding means RECENT behavioral trajectory, not identity, not
// lifetime history. Formally:
//   trajectoryEmbedding =
//     L2Normalize( mean( last `trajectoryWindowSize` BehaviorEvent.embedding
//                        ordered by occurredAt desc ) )
//
// `direction` is computed from the last `directionWindowSize` behaviorTypes via
// a deterministic rule table. Window sizes are stored per-row so a future A/B
// (e.g. 100 vs 50) is config, not a schema migration.
model PolicyTrajectory {
  policyId             String                       @id
  policy               Policy                       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  operatingTenantId    String
  operatingTenant      Tenant                       @relation("PolicyTrajectoryTenant", fields: [operatingTenantId], references: [id])
  eventCount           Int                          @default(0)
  lastEventAt          DateTime?
  lastBehaviorTypes    Json                         @db.JsonB // last `directionWindowSize` behaviorTypes, chronological
  direction            String                       @default("HEALTHY")
  driftScore           Decimal                      @default(0)
  trajectoryEmbedding  Unsupported("vector(1536)")? // L2-normalized mean of last N event embeddings
  trajectoryWindowSize Int                          @default(50)
  directionWindowSize  Int                          @default(20)
  updatedAt            DateTime                     @updatedAt

  @@index([operatingTenantId])
  @@index([direction])
  @@map("policy_trajectories")
}

// Gen2: Archived versions of quotes when unlocked for editing
model PolicyQuoteHistory {
