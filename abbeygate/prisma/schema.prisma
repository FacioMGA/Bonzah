// Immutable Log of Policy Lifecycle Events (Inception, Endorsement, Cancellation)
model RiskTransaction {
  id                String           @id @default(uuid())
  operatingTenantId String
  operatingTenant   Tenant           @relation("RiskTransactionOperatingTenant", fields: [operatingTenantId], references: [id])
  policyId          String
  policy            Policy           @relation(fields: [policyId], references: [id], onDelete: Cascade)
  programId         String?
  program           Program?         @relation(fields: [programId], references: [id])
  binderId          String?
  binder            Binder?          @relation(fields: [binderId], references: [id])
  reportingPeriodId String?
  reportingPeriod   ReportingPeriod? @relation(fields: [reportingPeriodId], references: [id])

  transactionNumber Int // Monotonic sequence per policy
  transactionType   String // INCEPTION, ENDORSEMENT, CANCELLATION, REINSTATEMENT
  status            String    @default("DRAFT") // DRAFT | REFERRED | APPROVED | BOUND
  effectiveDate     DateTime
  expiryDate        DateTime?
  changeReason      String?
  paymentMode       String? // CUSTOMER_CARD | OFFLINE | INVOICE | WAIVED
  paymentNote       String?
  issuedByUserId    String?

  // Link to other sources
  endorsementId String? // Optional link to legacy Endorsement table

  // Frozen sources for audit-ready documents (bound snapshot)
  snapshotDraft Json?   @db.JsonB
  snapshotFinal Json?   @db.JsonB
  pricingFinal  Json?   @db.JsonB
  snapshotHash  String?
  pricingHash   String?

  createdAt DateTime @default(now())
  createdBy String?

  premiumTransactions    PremiumTransaction[]
  documents              Document[]
  payments               Payment[]
  endorsementInstances   EndorsementInstance[]
  documentSets           DocumentSet[]
  motorMarketSubmissions MotorMarketSubmission[]

  @@unique([policyId, transactionNumber])
  @@index([operatingTenantId])
  @@index([policyId])
  @@index([policyId, transactionType, status, transactionNumber(sort: Desc)])
  @@index([programId])
  @@index([binderId])
  @@index([reportingPeriodId])
  @@map("risk_transactions")
}

// Immutable Log of Financial Impact (One Risk Txn -> Many Premium Txns)
model PremiumTransaction {
  id                String          @id @default(uuid())
  riskTransactionId String
  riskTransaction   RiskTransaction @relation(fields: [riskTransactionId], references: [id], onDelete: Cascade)

  transactionType String // ORIGINAL, ADDITIONAL, RETURN
  currency        String @default("USD")

  grossPremium      Decimal @default(0)
  commissionPercent Decimal @default(0)
  commissionAmount  Decimal @default(0)
  taxesTotal        Decimal @default(0)
  feesTotal         Decimal @default(0)
  netToLondon       Decimal @default(0)

  createdAt DateTime @default(now())

  taxLines TaxLine[]

  @@index([riskTransactionId])
  @@map("premium_transactions")
}

model TaxLine {
  id                   String             @id @default(uuid())
  premiumTransactionId String
  premiumTransaction   PremiumTransaction @relation(fields: [premiumTransactionId], references: [id], onDelete: Cascade)

  lineNo        Int // 1 to 5
  jurisdiction  String? // State/Country
  taxType       String? // Surplus Lines, Fire Tax, etc.
  taxableAmount Decimal  @default(0)
  taxAmount     Decimal  @default(0)
  rate          Decimal? // Can be % or fixed

  @@index([premiumTransactionId])
  @@map("tax_lines")
}

